# Copy to .env and edit. Docker Compose loads this file automatically:
#   cp .env.example .env
#
# Everything here is optional except DATASET (required for list/run/evaluate —
# there is no default dataset) and AGENT_MODEL + MODEL_NAME when PIPELINE_CMD=run
# (there is no default model name either).
# Values can also be overridden ad hoc, e.g. `LIMIT=3 AGENT_MODEL=sonnet:high docker compose up runner`.

# ---------------------------------------------------------------------------
# Pipeline selection (steps 1-4)
# ---------------------------------------------------------------------------

# Which subcommand the container runs: list | run | evaluate | report
PIPELINE_CMD=run

# Dataset identifier: <benchmark>:<dataset> (split is fixed to "test" in the script).
# There is no default dataset.
DATASET=

# Skip the first N instances (selection window is [SKIP, SKIP+LIMIT)).
SKIP=0

# Take the next N instances after SKIP. 0 = all remaining.
LIMIT=5

# ---------------------------------------------------------------------------
# Agent runner (required for PIPELINE_CMD=run)
# ---------------------------------------------------------------------------

# Which agent runs the instances (see src/agents/). Default: pi.
AGENT=pi

# Passed to the agent as its model, e.g. sonnet:high, opus, gpt-5:high
AGENT_MODEL=sonnet:high

# Name recorded in predictions and reports; identifies the system under test.
# There is no default — it must be supplied explicitly.
MODEL_NAME=

# Extra args appended verbatim to the agent invocation, e.g. "--thinking high"
AGENT_EXTRA_ARGS=

# Per-instance wall-clock budget in seconds. Partial edits are kept on timeout.
AGENT_TIMEOUT=1800

# Your Pi home directory (~/.pi). It contains the agent/ subdir that holds
# auth.json, models.json and custom providers. Mounted at /root/.pi inside the
# container, so Pi finds ~/.pi/agent automatically.
# Leave unset to use the local ./.pi-home folder (run `pi auth login` inside).
# (`PI_AGENT_DIR` is still accepted as a legacy alias for this value.)
PI_HOME=

# ---------------------------------------------------------------------------
# Step 5: evaluation harness (profile "eval"; bundled SWE-bench benchmark)
# ---------------------------------------------------------------------------

# Name of the evaluation run (also the report/run_id prefix).
EVAL_RUN_ID=bench-docker

# Predictions file to evaluate (path inside the container).
# Leave unset to auto-detect the newest runs/<timestamp>/predictions.jsonl.
# PREDICTIONS=/app/runs/20260101-000000/predictions.jsonl

# Parallel Docker workers used by the harness.
EVAL_WORKERS=4

# The harness always writes its reports under `logs/` (mapped to ./logs on
# the host, so the aggregate report survives the container).

# ---------------------------------------------------------------------------
# Credentials (uncomment the one you use; passed into the container)
# ---------------------------------------------------------------------------

# Hugging Face token (only needed for gated/private datasets).
# HF_TOKEN=

# Anthropic   ANTHROPIC_API_KEY=
# OpenAI      OPENAI_API_KEY=
# Google      GEMINI_API_KEY=
# OpenRouter  OPENROUTER_API_KEY=
# DeepSeek    DEEPSEEK_API_KEY=
# Mistral     MISTRAL_API_KEY=
# Groq        GROQ_API_KEY=
# xAI         XAI_API_KEY=
