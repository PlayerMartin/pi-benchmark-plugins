# Copy to .env and fill in. Any agent (src/agents/) and any benchmark
# (src/benchmarks/) can be used; values below are what `run` needs.
# Everything else has a default: override ad hoc (`LIMIT=3 docker compose up run`)
# or via `docker compose run --rm run <cli-args>`. Credentials for your agent's
# provider go here too (e.g. ANTHROPIC_API_KEY=...) — they are passed through.

# <benchmark>:<dataset>, e.g. swebench:SWE-bench/SWE-bench_Lite
DATASET=

# Model your agent runs, e.g. sonnet:high
AGENT_MODEL=

# Name recorded in predictions and reports
MODEL_NAME=

# Instances to run (0 = all)
LIMIT=0

# Optional: host path to your Pi home (~/.pi) for the bundled pi agent
# PI_HOME=
